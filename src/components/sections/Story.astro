---
/**
 * Historia: quién es CRISTIAN y Gálatas 2:20.
 * data-words: el versículo se enciende palabra por palabra al leerlo (motion.ts).
 * data-quote-rule: la línea amarilla que lo subraya.
 */
import SectionTitle from "@/components/ui/SectionTitle.astro"
import { SITE } from "@/config/site"
---

<section
  id="historia"
  aria-labelledby="historia-title"
  data-ground="indigo>night"
  data-ground-late
  class="bg-[linear-gradient(to_bottom,var(--color-indigo),var(--color-night)_40%)] px-4 pt-16 pb-28 sm:px-8 sm:pt-24 sm:pb-36"
>
  <div class="mx-auto grid max-w-7xl gap-x-16 gap-y-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)]">
    <div>
      <SectionTitle id="historia-title">Historia</SectionTitle>
      <div class="mt-8 max-w-[62ch] space-y-5 text-lg leading-relaxed text-white/90">
        <!-- prettier-ignore -->
        <p>
          {SITE.info.name} canta desde {SITE.location.display}. Se presenta así:
          <strong class="font-semibold text-white">«{SITE.info.slogan}»</strong>,
          y su música lo dice a su manera: salsa, urbano y adoración, con
          canciones que nacen de la Escritura, como «Salmo 1», «Gálatas 2:20» o
          «Príncipe De Paz».
        </p>
        <p>
          Abrió su canal en mayo de 2025 con «Gracias Mamá». Después llegaron
          «Cristo Es Lo Mejor» y «Gálatas 2:20», y en febrero de 2026 publicó{" "}
          <em class="font-semibold text-white not-italic">Exuberante</em>, un
          álbum de siete canciones que va de la oración de «Padre Ayúdame» al
          sabor de «Me Siento Relajao».
        </p>
        <p>
          En 2026 siguió con «Mi Artista Favorito», «Salsalipsis» y «Gracia». El
          camino sigue.
        </p>
      </div>
    </div>

    <figure
      class="self-center lg:pt-24"
      data-quote
    >
      <blockquote class="text-[clamp(1.75rem,3.6vw,2.9rem)] leading-[1.15] font-semibold text-white [font-stretch:108%] [hanging-punctuation:first]">
        <p data-words>
          «Con Cristo estoy juntamente crucificado, y ya no vivo yo, mas vive
          Cristo en mí.»
        </p>
      </blockquote>
      <span
        aria-hidden="true"
        data-quote-rule
        class="mt-8 block h-0.5 w-24 origin-left bg-sun"
      ></span>
      <figcaption class="mt-4 text-lg font-bold text-sun uppercase [font-stretch:120%]">
        Gálatas 2:20{" "}
        <span class="font-medium text-white/75 normal-case [font-stretch:100%]">
          · Reina-Valera 1960
        </span>
      </figcaption>
    </figure>
  </div>
</section>
