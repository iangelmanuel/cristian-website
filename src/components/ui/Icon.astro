---
/**
 * Iconos SVG en línea: marcas de simple-icons más «play» y la flecha diagonal.
 * Siempre decorativos (aria-hidden); el texto vecino da el nombre accesible.
 */
import { siInstagram, siSpotify, siTiktok, siYoutube } from "simple-icons"

const BRANDS = {
  youtube: siYoutube.path,
  spotify: siSpotify.path,
  instagram: siInstagram.path,
  tiktok: siTiktok.path
}

export type IconName = keyof typeof BRANDS | "play" | "arrow"

interface Props {
  name: IconName
  class?: string
}

const { name, class: className = "size-5" } = Astro.props
---

{name === "arrow" ? (
  <svg
    class={className}
    viewBox="0 0 24 24"
    aria-hidden="true"
    fill="none"
    stroke="currentColor"
    stroke-width="2.25"
    stroke-linecap="square"
  >
    <path d="M6 18 18 6M8 6h10v10" />
  </svg>
) : (
  <svg
    class={className}
    viewBox="0 0 24 24"
    aria-hidden="true"
    fill="currentColor"
  >
    <path
      d={
        name === "play"
          ? "M7 4.5v15a1 1 0 0 0 1.52.85l12.2-7.5a1 1 0 0 0 0-1.7L8.52 3.65A1 1 0 0 0 7 4.5Z"
          : BRANDS[name]
      }
    />
  </svg>
)}
